version 18
clear all
set more off
set processors 2
local out "@OUTPUT@"
local base "@BASE@"
capture log close
log using "`out'/isolated_rerun.log", text replace
tempname rr
postfile `rr' str12 family str20 method str24 fe str24 term double(b se p lo hi N G) using "`out'/rerun_results.dta", replace
use "`base'/control_FE_sensitivity_post4/fixed_panel.dta", clear
isid person_id year
egen py=group(anchor_province year)
gen double d_m4=(k==-4)*C0
gen double all_d_m4=(k==-4)
gen double d_m3=(k==-3)*C0
gen double all_d_m3=(k==-3)
gen double d_m2=(k==-2)*C0
gen double all_d_m2=(k==-2)
gen double d_p0=(k==0)*C0
gen double all_d_p0=(k==0)
gen double d_p1=(k==1)*C0
gen double all_d_p1=(k==1)
gen double d_p2=(k==2)*C0
gen double all_d_p2=(k==2)
gen double d_p3=(k==3)*C0
gen double all_d_p3=(k==3)
gen double d_p4=(k==4)*C0
gen double all_d_p4=(k==4)
reghdfe Y d_m4 d_m3 d_m2 d_p0 d_p1 d_p2 d_p3 d_p4 age2 tenure tenure2 i.base_rank i.role_secretary gdp_growth_lag lngdppc_lag lnpop_lag all_d_m4 all_d_m3 all_d_m2 all_d_p0 all_d_p1 all_d_p2 all_d_p3 all_d_p4, absorb(person_id year) vce(cluster anchor_province)
local NN=e(N)
local GG=e(N_clust)
local DD=e(df_r)
quietly lincom d_m4, level(95)
post `rr' ("annual") ("TWFE_fixed") ("I_YEAR") ("d_m4") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (`NN') (`GG')
quietly lincom d_m3, level(95)
post `rr' ("annual") ("TWFE_fixed") ("I_YEAR") ("d_m3") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (`NN') (`GG')
quietly lincom d_m2, level(95)
post `rr' ("annual") ("TWFE_fixed") ("I_YEAR") ("d_m2") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (`NN') (`GG')
quietly lincom d_p0, level(95)
post `rr' ("annual") ("TWFE_fixed") ("I_YEAR") ("d_p0") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (`NN') (`GG')
quietly lincom d_p1, level(95)
post `rr' ("annual") ("TWFE_fixed") ("I_YEAR") ("d_p1") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (`NN') (`GG')
quietly lincom d_p2, level(95)
post `rr' ("annual") ("TWFE_fixed") ("I_YEAR") ("d_p2") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (`NN') (`GG')
quietly lincom d_p3, level(95)
post `rr' ("annual") ("TWFE_fixed") ("I_YEAR") ("d_p3") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (`NN') (`GG')
quietly lincom d_p4, level(95)
post `rr' ("annual") ("TWFE_fixed") ("I_YEAR") ("d_p4") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (`NN') (`GG')
quietly lincom (d_p1+d_p2+d_p3+d_p4)/4, level(95)
post `rr' ("annual") ("TWFE_fixed") ("I_YEAR") ("post_average") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (`NN') (`GG')
eventstudyinteract Y d_m4 d_m3 d_m2 d_p0 d_p1 d_p2 d_p3 d_p4, cohort(treated_cohort) control_cohort(never) absorb(person_id year) covariates(age2 tenure tenure2 i.base_rank i.role_secretary gdp_growth_lag lngdppc_lag lnpop_lag all_d_m4 all_d_m3 all_d_m2 all_d_p0 all_d_p1 all_d_p2 all_d_p3 all_d_p4) vce(cluster anchor_province)
local NN=e(N)
local GG=e(N_clust)
local DD=e(df_r)
matrix BI=e(b_iw)
matrix VI=e(V_iw)
ereturn post BI VI, obs(`NN') dof(`DD')

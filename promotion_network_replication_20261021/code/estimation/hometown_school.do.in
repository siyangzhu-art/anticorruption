version 18
clear all
set more off
set processors 2
local out "@OUTPUT@"
capture log close
log using "`out'/estimation.log", text replace
which reghdfe
which eventstudyinteract
tempname rr mm jj vv ff ww
postfile `rr' long model_id str18 method str24 term double b se p lo hi using "`out'/coefficients.dta", replace
postfile `mm' long model_id str18 method double N G df K using "`out'/models.dta", replace
postfile `jj' long model_id str18 method str24 test double F df_num p using "`out'/joint_tests.dta", replace
postfile `vv' long model_id str18 method str16 term1 str16 term2 double value using "`out'/covariances.dta", replace
postfile `ff' long model_id str18 method long rc using "`out'/failures.dta", replace
postfile `ww' long model_id long cohort str16 term double weight using "`out'/SA_weights.dta", replace
use "@BASE@/hometown_classmate_fixed_event_study_2026_10_21/data/hometown_prefecture_panel.dta", clear
isid person_id year
egen py=group(anchor_province year)
gen double all_d_m4=(k==-4)
gen double d_m4=(k==-4)*C0
gen double all_d_m3=(k==-3)
gen double d_m3=(k==-3)*C0
gen double all_d_m2=(k==-2)
gen double d_m2=(k==-2)*C0
gen double all_d_p0=(k==0)
gen double d_p0=(k==0)*C0
gen double all_d_p1=(k==1)
gen double d_p1=(k==1)*C0
gen double all_d_p2=(k==2)
gen double d_p2=(k==2)*C0
gen double all_d_p3=(k==3)
gen double d_p3=(k==3)*C0
gen double all_d_p4=(k==4)
capture noisily reghdfe Y d_m4 d_m3 d_m2 d_p0 d_p1 d_p2 d_p3 age2 tenure tenure2 i.base_rank i.role_secretary gdp_growth_lag lngdppc_lag lnpop_lag all_d_m4 all_d_m3 all_d_m2 all_d_p0 all_d_p1 all_d_p2 all_d_p3 all_d_p4, absorb(person_id year) vce(cluster anchor_province)
local rc=_rc
if `rc'!=0 post `ff' (1) ("TWFE_fixed") (`rc')
if `rc'==0 {
local NN=e(N)
local GG=e(N_clust)
local DD=e(df_r)
local KK=e(df_m)+e(df_a)
assert `NN'==2731
post `mm' (1) ("TWFE_fixed") (`NN') (`GG') (`DD') (`KK')
quietly lincom d_m4, level(95)
post `rr' (1) ("TWFE_fixed") ("d_m4") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
quietly lincom d_m3, level(95)
post `rr' (1) ("TWFE_fixed") ("d_m3") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
quietly lincom d_m2, level(95)
post `rr' (1) ("TWFE_fixed") ("d_m2") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
quietly lincom d_p0, level(95)
post `rr' (1) ("TWFE_fixed") ("d_p0") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
quietly lincom d_p1, level(95)
post `rr' (1) ("TWFE_fixed") ("d_p1") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
quietly lincom d_p2, level(95)
post `rr' (1) ("TWFE_fixed") ("d_p2") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
quietly lincom d_p3, level(95)
post `rr' (1) ("TWFE_fixed") ("d_p3") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
capture quietly test d_m4 d_m3 d_m2
if _rc==0 {
post `jj' (1) ("TWFE_fixed") ("pretrend") (r(F)) (r(df)) (r(p))
}
matrix VV=e(V)
post `vv' (1) ("TWFE_fixed") ("d_m4") ("d_m4") (VV[rownumb(VV,"d_m4"),colnumb(VV,"d_m4")])
post `vv' (1) ("TWFE_fixed") ("d_m4") ("d_m3") (VV[rownumb(VV,"d_m4"),colnumb(VV,"d_m3")])
post `vv' (1) ("TWFE_fixed") ("d_m4") ("d_m2") (VV[rownumb(VV,"d_m4"),colnumb(VV,"d_m2")])
post `vv' (1) ("TWFE_fixed") ("d_m4") ("d_p0") (VV[rownumb(VV,"d_m4"),colnumb(VV,"d_p0")])
post `vv' (1) ("TWFE_fixed") ("d_m4") ("d_p1") (VV[rownumb(VV,"d_m4"),colnumb(VV,"d_p1")])
post `vv' (1) ("TWFE_fixed") ("d_m4") ("d_p2") (VV[rownumb(VV,"d_m4"),colnumb(VV,"d_p2")])
post `vv' (1) ("TWFE_fixed") ("d_m4") ("d_p3") (VV[rownumb(VV,"d_m4"),colnumb(VV,"d_p3")])
post `vv' (1) ("TWFE_fixed") ("d_m3") ("d_m4") (VV[rownumb(VV,"d_m3"),colnumb(VV,"d_m4")])
post `vv' (1) ("TWFE_fixed") ("d_m3") ("d_m3") (VV[rownumb(VV,"d_m3"),colnumb(VV,"d_m3")])
post `vv' (1) ("TWFE_fixed") ("d_m3") ("d_m2") (VV[rownumb(VV,"d_m3"),colnumb(VV,"d_m2")])
post `vv' (1) ("TWFE_fixed") ("d_m3") ("d_p0") (VV[rownumb(VV,"d_m3"),colnumb(VV,"d_p0")])
post `vv' (1) ("TWFE_fixed") ("d_m3") ("d_p1") (VV[rownumb(VV,"d_m3"),colnumb(VV,"d_p1")])
post `vv' (1) ("TWFE_fixed") ("d_m3") ("d_p2") (VV[rownumb(VV,"d_m3"),colnumb(VV,"d_p2")])
post `vv' (1) ("TWFE_fixed") ("d_m3") ("d_p3") (VV[rownumb(VV,"d_m3"),colnumb(VV,"d_p3")])
post `vv' (1) ("TWFE_fixed") ("d_m2") ("d_m4") (VV[rownumb(VV,"d_m2"),colnumb(VV,"d_m4")])
post `vv' (1) ("TWFE_fixed") ("d_m2") ("d_m3") (VV[rownumb(VV,"d_m2"),colnumb(VV,"d_m3")])
post `vv' (1) ("TWFE_fixed") ("d_m2") ("d_m2") (VV[rownumb(VV,"d_m2"),colnumb(VV,"d_m2")])
post `vv' (1) ("TWFE_fixed") ("d_m2") ("d_p0") (VV[rownumb(VV,"d_m2"),colnumb(VV,"d_p0")])
post `vv' (1) ("TWFE_fixed") ("d_m2") ("d_p1") (VV[rownumb(VV,"d_m2"),colnumb(VV,"d_p1")])
post `vv' (1) ("TWFE_fixed") ("d_m2") ("d_p2") (VV[rownumb(VV,"d_m2"),colnumb(VV,"d_p2")])
post `vv' (1) ("TWFE_fixed") ("d_m2") ("d_p3") (VV[rownumb(VV,"d_m2"),colnumb(VV,"d_p3")])
post `vv' (1) ("TWFE_fixed") ("d_p0") ("d_m4") (VV[rownumb(VV,"d_p0"),colnumb(VV,"d_m4")])
post `vv' (1) ("TWFE_fixed") ("d_p0") ("d_m3") (VV[rownumb(VV,"d_p0"),colnumb(VV,"d_m3")])
post `vv' (1) ("TWFE_fixed") ("d_p0") ("d_m2") (VV[rownumb(VV,"d_p0"),colnumb(VV,"d_m2")])
post `vv' (1) ("TWFE_fixed") ("d_p0") ("d_p0") (VV[rownumb(VV,"d_p0"),colnumb(VV,"d_p0")])
post `vv' (1) ("TWFE_fixed") ("d_p0") ("d_p1") (VV[rownumb(VV,"d_p0"),colnumb(VV,"d_p1")])
post `vv' (1) ("TWFE_fixed") ("d_p0") ("d_p2") (VV[rownumb(VV,"d_p0"),colnumb(VV,"d_p2")])
post `vv' (1) ("TWFE_fixed") ("d_p0") ("d_p3") (VV[rownumb(VV,"d_p0"),colnumb(VV,"d_p3")])
post `vv' (1) ("TWFE_fixed") ("d_p1") ("d_m4") (VV[rownumb(VV,"d_p1"),colnumb(VV,"d_m4")])
post `vv' (1) ("TWFE_fixed") ("d_p1") ("d_m3") (VV[rownumb(VV,"d_p1"),colnumb(VV,"d_m3")])
post `vv' (1) ("TWFE_fixed") ("d_p1") ("d_m2") (VV[rownumb(VV,"d_p1"),colnumb(VV,"d_m2")])
post `vv' (1) ("TWFE_fixed") ("d_p1") ("d_p0") (VV[rownumb(VV,"d_p1"),colnumb(VV,"d_p0")])
post `vv' (1) ("TWFE_fixed") ("d_p1") ("d_p1") (VV[rownumb(VV,"d_p1"),colnumb(VV,"d_p1")])
post `vv' (1) ("TWFE_fixed") ("d_p1") ("d_p2") (VV[rownumb(VV,"d_p1"),colnumb(VV,"d_p2")])
post `vv' (1) ("TWFE_fixed") ("d_p1") ("d_p3") (VV[rownumb(VV,"d_p1"),colnumb(VV,"d_p3")])
post `vv' (1) ("TWFE_fixed") ("d_p2") ("d_m4") (VV[rownumb(VV,"d_p2"),colnumb(VV,"d_m4")])
post `vv' (1) ("TWFE_fixed") ("d_p2") ("d_m3") (VV[rownumb(VV,"d_p2"),colnumb(VV,"d_m3")])
post `vv' (1) ("TWFE_fixed") ("d_p2") ("d_m2") (VV[rownumb(VV,"d_p2"),colnumb(VV,"d_m2")])
post `vv' (1) ("TWFE_fixed") ("d_p2") ("d_p0") (VV[rownumb(VV,"d_p2"),colnumb(VV,"d_p0")])
post `vv' (1) ("TWFE_fixed") ("d_p2") ("d_p1") (VV[rownumb(VV,"d_p2"),colnumb(VV,"d_p1")])
post `vv' (1) ("TWFE_fixed") ("d_p2") ("d_p2") (VV[rownumb(VV,"d_p2"),colnumb(VV,"d_p2")])
post `vv' (1) ("TWFE_fixed") ("d_p2") ("d_p3") (VV[rownumb(VV,"d_p2"),colnumb(VV,"d_p3")])
post `vv' (1) ("TWFE_fixed") ("d_p3") ("d_m4") (VV[rownumb(VV,"d_p3"),colnumb(VV,"d_m4")])
post `vv' (1) ("TWFE_fixed") ("d_p3") ("d_m3") (VV[rownumb(VV,"d_p3"),colnumb(VV,"d_m3")])
post `vv' (1) ("TWFE_fixed") ("d_p3") ("d_m2") (VV[rownumb(VV,"d_p3"),colnumb(VV,"d_m2")])
post `vv' (1) ("TWFE_fixed") ("d_p3") ("d_p0") (VV[rownumb(VV,"d_p3"),colnumb(VV,"d_p0")])
post `vv' (1) ("TWFE_fixed") ("d_p3") ("d_p1") (VV[rownumb(VV,"d_p3"),colnumb(VV,"d_p1")])
post `vv' (1) ("TWFE_fixed") ("d_p3") ("d_p2") (VV[rownumb(VV,"d_p3"),colnumb(VV,"d_p2")])
post `vv' (1) ("TWFE_fixed") ("d_p3") ("d_p3") (VV[rownumb(VV,"d_p3"),colnumb(VV,"d_p3")])
}
capture noisily eventstudyinteract Y d_m4 d_m3 d_m2 d_p0 d_p1 d_p2 d_p3, cohort(treated_cohort) control_cohort(never) absorb(person_id year) covariates(age2 tenure tenure2 i.base_rank i.role_secretary gdp_growth_lag lngdppc_lag lnpop_lag all_d_m4 all_d_m3 all_d_m2 all_d_p0 all_d_p1 all_d_p2 all_d_p3 all_d_p4) vce(cluster anchor_province)
local rc=_rc
if `rc'!=0 post `ff' (1) ("Sun_Abraham") (`rc')
if `rc'==0 {
local NN=e(N)
local GG=e(N_clust)
local DD=e(df_r)
local KK=e(df_m)+e(df_a)
assert `NN'==2731
post `mm' (1) ("Sun_Abraham") (`NN') (`GG') (`DD') (`KK')
matrix BI=e(b_iw)
matrix VI=e(V_iw)
matrix WI=e(ff_w)
post `ww' (1) (2013) ("d_m4") (WI[1,1])
post `ww' (1) (2014) ("d_m4") (WI[2,1])
post `ww' (1) (2013) ("d_m3") (WI[1,2])
post `ww' (1) (2014) ("d_m3") (WI[2,2])
post `ww' (1) (2013) ("d_m2") (WI[1,3])
post `ww' (1) (2014) ("d_m2") (WI[2,3])
post `ww' (1) (2013) ("d_p0") (WI[1,4])
post `ww' (1) (2014) ("d_p0") (WI[2,4])
post `ww' (1) (2013) ("d_p1") (WI[1,5])
post `ww' (1) (2014) ("d_p1") (WI[2,5])
post `ww' (1) (2013) ("d_p2") (WI[1,6])
post `ww' (1) (2014) ("d_p2") (WI[2,6])
post `ww' (1) (2013) ("d_p3") (WI[1,7])
post `ww' (1) (2014) ("d_p3") (WI[2,7])
ereturn post BI VI, obs(`NN') dof(`DD')
quietly lincom d_m4, level(95)
post `rr' (1) ("Sun_Abraham") ("d_m4") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
quietly lincom d_m3, level(95)
post `rr' (1) ("Sun_Abraham") ("d_m3") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
quietly lincom d_m2, level(95)
post `rr' (1) ("Sun_Abraham") ("d_m2") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
quietly lincom d_p0, level(95)
post `rr' (1) ("Sun_Abraham") ("d_p0") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
quietly lincom d_p1, level(95)
post `rr' (1) ("Sun_Abraham") ("d_p1") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
quietly lincom d_p2, level(95)
post `rr' (1) ("Sun_Abraham") ("d_p2") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
quietly lincom d_p3, level(95)
post `rr' (1) ("Sun_Abraham") ("d_p3") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
capture quietly test d_m4 d_m3 d_m2
if _rc==0 {
post `jj' (1) ("Sun_Abraham") ("pretrend") (r(F)) (r(df)) (r(p))
}
matrix VV=e(V)
post `vv' (1) ("Sun_Abraham") ("d_m4") ("d_m4") (VV[rownumb(VV,"d_m4"),colnumb(VV,"d_m4")])
post `vv' (1) ("Sun_Abraham") ("d_m4") ("d_m3") (VV[rownumb(VV,"d_m4"),colnumb(VV,"d_m3")])
post `vv' (1) ("Sun_Abraham") ("d_m4") ("d_m2") (VV[rownumb(VV,"d_m4"),colnumb(VV,"d_m2")])
post `vv' (1) ("Sun_Abraham") ("d_m4") ("d_p0") (VV[rownumb(VV,"d_m4"),colnumb(VV,"d_p0")])
post `vv' (1) ("Sun_Abraham") ("d_m4") ("d_p1") (VV[rownumb(VV,"d_m4"),colnumb(VV,"d_p1")])
post `vv' (1) ("Sun_Abraham") ("d_m4") ("d_p2") (VV[rownumb(VV,"d_m4"),colnumb(VV,"d_p2")])
post `vv' (1) ("Sun_Abraham") ("d_m4") ("d_p3") (VV[rownumb(VV,"d_m4"),colnumb(VV,"d_p3")])
post `vv' (1) ("Sun_Abraham") ("d_m3") ("d_m4") (VV[rownumb(VV,"d_m3"),colnumb(VV,"d_m4")])
post `vv' (1) ("Sun_Abraham") ("d_m3") ("d_m3") (VV[rownumb(VV,"d_m3"),colnumb(VV,"d_m3")])
post `vv' (1) ("Sun_Abraham") ("d_m3") ("d_m2") (VV[rownumb(VV,"d_m3"),colnumb(VV,"d_m2")])
post `vv' (1) ("Sun_Abraham") ("d_m3") ("d_p0") (VV[rownumb(VV,"d_m3"),colnumb(VV,"d_p0")])
post `vv' (1) ("Sun_Abraham") ("d_m3") ("d_p1") (VV[rownumb(VV,"d_m3"),colnumb(VV,"d_p1")])
post `vv' (1) ("Sun_Abraham") ("d_m3") ("d_p2") (VV[rownumb(VV,"d_m3"),colnumb(VV,"d_p2")])
post `vv' (1) ("Sun_Abraham") ("d_m3") ("d_p3") (VV[rownumb(VV,"d_m3"),colnumb(VV,"d_p3")])
